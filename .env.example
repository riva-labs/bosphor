# EVM (Sepolia)
EVM_RPC_URL=https://1rpc.io/sepolia
EVM_ADAPTER_ADDRESS=
EVM_RELAYER_KEY=

# Sui (testnet)
SUI_GRPC_URL=https://sui-testnet.mystenlabs.com
SUI_DEPLOYER_KEY=
SUI_RELAYER_KEY=
SUI_PACKAGE_ID=
SUI_CONFIG_ID=
SUI_LZ_PACKAGE_ID=
SUI_LZ_CONFIG_ID=
SUI_LZ_OAPP_ID=
SUI_LZ_ADMIN_CAP_ID=
SUI_LZ_MESSAGING_CHANNEL=
# M3: Walrus System shared object (testnet). execute_store reads the current epoch
# from it to assert the committed storage duration. See scripts/deploy/M3_REDEPLOY.md.
SUI_WALRUS_SYSTEM_ID=

# LZ v2 infrastructure (Sui testnet shared objects)
SUI_LZ_OAPP_PKG=0x04c440985f5deab2fb7f821b3288d93225a3e637cf22dda476809836f0533751
SUI_LZ_BYTES32_PKG=0x04c440985f5deab2fb7f821b3288d93225a3e637cf22dda476809836f0533751
SUI_LZ_ENDPOINT_V2_OBJ=0x2b96537c30c5fa962a1bfb58a168fc17c17f2546c88e2e9252f21ee7d5eff57a
SUI_LZ_ULN302=0xf5d69c7b0922ce0ab4540525fbc66ca25ce9f092c64b032b91e4c5625ea0fb24
SUI_LZ_ULN302_OBJ=0x69541d4feeb08cdd3b20b3502021a676eea0fca4f47d46e423cdc9686df406ff
SUI_LZ_DVN_PKG=0xfa5a7bd745a56f3f18f4830563c8b65a737dcfca5b9e5aa281f2f2cd3f6eaf6d
SUI_LZ_EXECUTOR_PKG=0xb9fdc6748fb939095e249b22717d564edf890681e387131d6c525d867d30f834

# LayerZero endpoints + EIDs (used by the deploy/wire/e2e scripts)
EVM_EID=40161                     # Sepolia
SUI_EID=40378                     # Sui testnet
LZ_ENDPOINT_ADDRESS=0x6EDCE65403992e310A62460808c4b910D972f10f   # Sepolia EndpointV2
# Type-3 executor lzReceive option (200k gas, 0 value).
LZ_OPTIONS=0x00030100110100000000000000000000000000030d40
LZ_USE_DEFAULT_DVNS=false         # true = use the LZ Labs default DVN set instead of the self-operated DVN
# Sui RPC endpoints for the scripts (gRPC is above as SUI_GRPC_URL).
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_JSONRPC_URL=https://fullnode.testnet.sui.io:443
# Optional: point the deploy scripts at a non-default env file.
BOSPHOR_ENV_FILE=.env

# Relayer ingest + e2e target. Local relayer by default; the hosted testnet
# relayer is https://api.bosphor.xyz/testnet (mainnet: https://api.bosphor.xyz).
RELAYER_URL=http://localhost:3000

# Solana (devnet) - only needed for the Solana origin scripts + canary probe.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR=                   # path to a Solana keypair JSON, e.g. ~/.config/solana/id.json
SUI_RECEIVER=                     # Sui OApp object id the Solana program targets as its peer
NATIVE_FEE=10000000               # lamports attached to the Solana submit (>= the LZ quote floor)

# Walrus (testnet)
WALRUS_RELAY_URL=https://relay.walrus-testnet.walrus.space
WALRUS_STORE_EPOCHS=5
# M3: upper bound (bytes) the intent-aware ingest endpoint accepts per blob.
MAX_INGEST_BLOB_BYTES=10485760

# Monitoring (docker-compose Grafana admin password; override for non-local use)
GRAFANA_ADMIN_PASSWORD=

# Observability (Sentry runtime error tracking for relayer + canary)
# Leave SENTRY_DSN empty to disable. Get a DSN from sentry.io (free tier).
# Never commit a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
