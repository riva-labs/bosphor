{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bosphor-sdk-docs",
  "compatibility_date": "2026-06-09",
  // Serves the SDK docs at sdk.bosphor.xyz. The zone bosphor.xyz must be on the
  // same Cloudflare account; wrangler binds the custom domain on deploy.
  "routes": [
    {
      "pattern": "sdk.bosphor.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // A tiny Worker answers retired URLs (redirects/map.mjs) with a 301 and hands
  // every other request to the static assets. Set the CANONICAL_ORIGIN var at
  // the docs.bosphor.xyz cutover to move other hosts there (see worker/index.mjs).
  "main": "worker/index.mjs",
  // Next.js static export (`next build` with output: 'export') emits to `out/`.
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Page requests reach the Worker first so the redirect map (and the later
    // host move) also covers paths that exist as assets. Hashed build files
    // skip the Worker.
    "run_worker_first": ["/*", "!/_next/*"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
