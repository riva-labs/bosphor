{
  "name": "bosphor-sdk-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Bosphor developer portal (docs, guides, SDK and API reference), built with Fumadocs.",
  "scripts": {
    "gen:sdk-ref": "node scripts/gen-sdk-reference.mjs",
    "build": "npm run gen:sdk-ref && next build && node scripts/markdown-aliases.mjs && npm run check",
    "check": "node scripts/check-links.mjs && node scripts/check-redirects.mjs && npm run test:worker",
    "test:worker": "node --test scripts/test-worker.mjs",
    "dev": "npm run gen:sdk-ref && next dev",
    "start": "serve out",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types:check": "npm run gen:sdk-ref && next typegen && tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@bosphor/sdk": "^0.14.2",
    "@solana/web3.js": "^1.99.0",
    "cnfast": "^0.2.0",
    "ethers": "^6.17.0",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-openapi": "^12.6.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.4",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~5.9",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "jayson": {
      ".": "^5.0.0",
      "ws": "^8.23.0"
    },
    "mermaid": {
      "katex": "^0.18.2"
    }
  }
}
