# Testnet overlay for the multi-chain canary (docker-compose.canary-testnet.yml).
# Copy to .env.canary-testnet (gitignored) and fill in. Loaded AFTER .env, so
# every key here overrides the mainnet .env for the canary container only.
#
# Bring the canary up against testnet without touching the running stack:
#   docker compose -f docker-compose.yml -f docker-compose.hosting.yml \
#     -f docker-compose.canary-testnet.yml up -d --build --no-deps canary

# --- EVM origin (Sepolia -> Sui testnet) ---
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_ADAPTER_ADDRESS=0x...            # M3 v6 testnet BosphorAdapter
EVM_RELAYER_KEY=0x...                # funded Sepolia canary sender (its own wallet)
SUI_EID=40378

# Blob upload target: the TESTNET relayer, reached over its public URL (the canary
# runs in the bosphor compose network; the testnet relayer is a separate project).
RELAYER_URL=https://api.bosphor.xyz/testnet

# --- Solana origin (devnet -> Sui testnet). Omit SOLANA_RPC_URL to disable. ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=7RCSzaG9NsK2BNMmLqQ22Zqrf6Te6Wvi5MNpknoit1AF
# Keypair the Solana probe submits with. The compose overlay mounts the canary's
# own devnet keypair at this path (separate from the relayer/return signer, so a
# drained canary cannot stop return legs); override with an inline JSON
# secret-key array if desired.
SOLANA_CANARY_KEYPAIR=/home/arb/.config/solana/bosphor-canary-devnet.json
SOLANA_DST_EID=40378
SOLANA_SUI_RECEIVER=0xbaa795269923a56b3159e974ca05350318bcb6e629aea618d01fc496543efee5
# lamports declared for the LZ send CPI. It is an upper bound the ULN checks
# (native_fee >= required, else InsufficientFee); only the computed fee is
# actually charged, so headroom is safe. 3e6 was too low on devnet; 2e7 clears it.
SOLANA_NATIVE_FEE=20000000
SOLANA_CU_LIMIT=400000               # compute units for the submit_intent CPI
SOLANA_MIN_BALANCE_SOL=0.05          # preflight: skip below this
# LZ v2 Solana program ids (defaults baked in; override only if they change):
# SOLANA_ENDPOINT_ID=76y77prsiCMvXMjuoZ5VRrhG5qYBrUMYTE5WgHqgjEn6
# SOLANA_ULN_ID=7a4WjyR8VZ7yZz5XJAKm39BUGn5iT9CKcv2pmG9tdXVH

# --- probe cadence + guards ---
CANARY_INTERVAL_MS=900000            # 15 min between round-trips per chain
# Solana-only override. Each Solana probe costs ~0.0087 SOL in LZ fees and devnet
# SOL can only be topped up by hand, so run Solana less often: at 30 min the
# canary burns ~0.42 SOL/day, so a 10 SOL top-up lasts ~3.4 weeks.
CANARY_SOLANA_INTERVAL_MS=1800000    # 30 min between Solana round-trips
CANARY_MAX_WAIT_MS=600000            # 10 min per round-trip (must be < interval)
CANARY_MIN_BALANCE_ETH=0.005
CANARY_MAX_GAS_GWEI=50

# --- service wallet watcher (bosphor_wallet_balance) ---
# Every service wallet on every chain, exported as
# bosphor_wallet_balance{chain,network,role,address,coin} in whole tokens.
# JSON array, inline or a path to a JSON file. Entry fields:
#   chain    sui | evm | solana
#   network  testnet | devnet | sepolia | mainnet (one network per chain)
#   address, role
#   coin     Sui only: full coin type for a non-SUI coin (e.g. WAL); default SUI
#   decimals optional; defaults SUI/WAL/SOL 9, ETH 18
#   floor, target, dailyCap   optional, whole tokens. floor+target opt the wallet
#            into the testnet top-up (refill to target when below floor, at most
#            dailyCap per rolling 24h; dailyCap defaults to target). Native coin only.
WALLET_WATCH=[{"chain":"sui","network":"testnet","address":"0xa11070a3877b77355a0afbc402559cae7501c666819f05491f0337016c219366","role":"relayer","floor":5,"target":20,"dailyCap":40},{"chain":"sui","network":"testnet","address":"0xa11070a3877b77355a0afbc402559cae7501c666819f05491f0337016c219366","role":"relayer","coin":"0x8270feb7375eee355e64fdb69c50abb6b5f9393a722883c1cf45f8e26048810a::wal::WAL"},{"chain":"sui","network":"testnet","address":"0x2be6623b17d5e22c4acc615ee2a190a0a9993db6c617f5079decc1eae56c887c","role":"dvn","floor":5,"target":20,"dailyCap":40},{"chain":"sui","network":"testnet","address":"0x545827b281cde00d2f3b15b03e0d6569ce081214ec3113cc633dea62657a540d","role":"treasury"},{"chain":"evm","network":"sepolia","address":"0x9665322fa22589Bf1d8612007717647819F3B290","role":"operator","floor":0.1,"target":0.5,"dailyCap":1},{"chain":"evm","network":"sepolia","address":"0x8C6B35a020e3B930ff3E577607eC2Db40007Bf1C","role":"canary","floor":0.05,"target":0.3,"dailyCap":0.6},{"chain":"solana","network":"devnet","address":"BQvCCQQj6Cd1ErZRrezaQJAAetExkGzAE3TKZAHpSn1E","role":"relayer","floor":1,"target":3,"dailyCap":5},{"chain":"solana","network":"devnet","address":"HnooBvpx8pSebZxaZx4GUq1vGQCfggjU9HLsaCQM58UA","role":"canary","floor":0.5,"target":2,"dailyCap":4}]
WALLET_WATCH_INTERVAL_MS=300000      # 5 min between balance reads
# RPCs (optional). Sui defaults to https://fullnode.<network>.sui.io:443 (gRPC),
# EVM falls back to EVM_RPC_URL, Solana to SOLANA_RPC_URL then the public cluster.
# WALLET_SUI_GRPC_URL=
# WALLET_EVM_RPC_URL=
# WALLET_SOLANA_RPC_URL=

# --- testnet auto top-up (optional) ---
# Refills wallets below their floor from a per-chain treasury. Runs ONLY when
# TOPUP_ENABLED=true AND both the entry's network and the RPC's detected chain
# are a test network (testnet/devnet/sepolia). On mainnet it is a no-op that
# only logs. A chain without a treasury key is watched and alerted on only.
# Each treasury key REQUIRES its floor: the treasury is never drawn below it.
TOPUP_ENABLED=false
# SUI_TREASURY_KEY=suiprivkey1...     # Sui deployer/treasury (0x5458...540d)
# SUI_TREASURY_FLOOR=50
# EVM_TREASURY_KEY=0x...              # funded Sepolia treasury
# EVM_TREASURY_FLOOR=0.5
# SOLANA_TREASURY_KEYPAIR=/path/to/devnet-treasury.json   # or inline JSON array; mount it in the compose overlay
# SOLANA_TREASURY_FLOOR=2

# --- error reporting (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=testnet
