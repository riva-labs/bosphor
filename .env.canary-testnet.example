# Testnet overlay for the multi-chain canary (docker-compose.canary-testnet.yml).
# Copy to .env.canary-testnet (gitignored) and fill in. Loaded AFTER .env, so
# every key here overrides the mainnet .env for the canary container only.
#
# Bring the canary up against testnet without touching the running stack:
#   docker compose -f docker-compose.yml -f docker-compose.hosting.yml \
#     -f docker-compose.canary-testnet.yml up -d --build --no-deps canary

# --- EVM origin (Sepolia -> Sui testnet) ---
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_ADAPTER_ADDRESS=0x...            # M3 v6 testnet BosphorAdapter
EVM_RELAYER_KEY=0x...                # funded Sepolia canary sender (its own wallet)
SUI_EID=40378

# Blob upload target: the TESTNET relayer, reached over its public URL (the canary
# runs in the bosphor compose network; the testnet relayer is a separate project).
RELAYER_URL=https://api.bosphor.xyz/testnet

# --- Solana origin (devnet -> Sui testnet). Omit SOLANA_RPC_URL to disable. ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=7RCSzaG9NsK2BNMmLqQ22Zqrf6Te6Wvi5MNpknoit1AF
# Keypair the Solana probe submits with. The compose overlay mounts the devnet
# keypair at this path; override with an inline JSON secret-key array if desired.
SOLANA_CANARY_KEYPAIR=/home/arb/.config/solana/bosphor-devnet.json
SOLANA_DST_EID=40378
SOLANA_SUI_RECEIVER=0xbaa795269923a56b3159e974ca05350318bcb6e629aea618d01fc496543efee5
SOLANA_NATIVE_FEE=3000000            # lamports attached to the LZ send CPI
SOLANA_CU_LIMIT=400000               # compute units for the submit_intent CPI
SOLANA_MIN_BALANCE_SOL=0.05          # preflight: skip below this
# LZ v2 Solana program ids (defaults baked in; override only if they change):
# SOLANA_ENDPOINT_ID=76y77prsiCMvXMjuoZ5VRrhG5qYBrUMYTE5WgHqgjEn6
# SOLANA_ULN_ID=7a4WjyR8VZ7yZz5XJAKm39BUGn5iT9CKcv2pmG9tdXVH

# --- probe cadence + guards ---
CANARY_INTERVAL_MS=900000            # 15 min between round-trips per chain
CANARY_MAX_WAIT_MS=600000            # 10 min per round-trip (must be < interval)
CANARY_MIN_BALANCE_ETH=0.005
CANARY_MAX_GAS_GWEI=50

# --- error reporting (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=testnet
