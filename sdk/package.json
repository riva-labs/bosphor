{
  "name": "@bosphor/sdk",
  "version": "0.5.0",
  "description": "Bosphor SDK: cross-chain storage intents for Walrus",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./commitment": "./src/commitment-codec.ts",
    "./evm": "./src/evm/index.ts",
    "./solana": "./src/solana/index.ts"
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "node --import tsx scripts/gen-parity-vectors.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "@solana/web3.js": "^1.98.0",
    "ethers": "^6.17.0"
  },
  "peerDependenciesMeta": {
    "@mysten/sui": {
      "optional": true
    },
    "@mysten/walrus": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2"
  }
}
